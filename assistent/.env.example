# Green API (WhatsApp)
# Get these from https://green-api.com/
GREEN_API_INSTANCE_ID=your_instance_id
GREEN_API_TOKEN=your_token

# Your WhatsApp phone number (with country code, no + or spaces)
# Example: 972501234567
WHATSAPP_PHONE=your_phone_number

# Google OAuth
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token

# Anthropic API (for Claude - command parsing & summaries)
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI API (for Whisper voice transcription)
# Get from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key

# Optional: Daily brief time (24-hour format)
# Default: 22:00
DAILY_BRIEF_HOUR=22
DAILY_BRIEF_MINUTE=0

# Optional: Reminder storage path
# Default: ./data/reminders.json
REMINDER_STORE_PATH=./data/reminders.json

# Optional: Target group name (only listen to this group)
# Default: AI-Assist
TARGET_GROUP_NAME=AI-Assist

# Optional: Set to 'true' to update the group picture on startup
# SET_GROUP_PICTURE=true
