# Bot token is NOT here: put it in ~/.config/credstore/telegram-claude-token (chmod 600)
ALLOWED_USER_ID=your_telegram_numeric_user_id
WORKING_DIR=/home/ofir-hadad/Desktop/Ofir
CLAUDE_BIN=/home/ofir-hadad/.local/bin/claude
# How much Claude may do without prompting (headless mode can't ask you).
# bypassPermissions = run anything | acceptEdits = auto-approve edits only | default = only pre-allowed tools
PERMISSION_MODE=bypassPermissions
