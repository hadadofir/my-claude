# Bot token is NOT here: put it in ~/.config/credstore/telegram-fitness-token (chmod 600)
FITNESS_ALLOWED_USER_ID=your_telegram_numeric_user_id
FITNESS_WORKING_DIR=/home/ofir-hadad/Desktop/Ofir/sandbox/telegram_claude/fitness_workspace
CLAUDE_BIN=/home/ofir-hadad/.local/bin/claude
# Optional: model alias for the coach (e.g. sonnet is cheaper for daily logging)
CLAUDE_MODEL=
TZ=Asia/Jerusalem
GARMIN_EMAIL=you@example.com
# Garmin password is NOT here: put it in ~/.config/credstore/garmin-password (chmod 600)
